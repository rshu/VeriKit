#!/usr/bin/env bash
# VeriKit PreToolUse Kit-selection monitor for Claude Code.
#
# LOG-ONLY: this hook never blocks an edit and never shows a message to the
# developer. When it observes a Kit-relevant edit that lacks a Kit selection it
# records a line in ~/.verikit/gate.log for debugging, then ALLOWS. Fires before
# Edit/Write/MultiEdit/NotebookEdit (scoped by the matcher in hooks.json).
#
#   1. A would-flag edit is an ArkTS (.ets) file whose new content imports a
#      HarmonyOS SDK module (@kit./@ohos./@hms.). Anything else -- non-.ets,
#      docs, config, pure ArkTS logic, UI-only scaffolding -- is ignored.
#   2. If such an edit happens AND no catalog Kit was named (and no
#      <verikit-no-kit> abstain was declared) in a reply since the last user
#      prompt, append a debug record. Otherwise nothing is logged.
#
# Always ALLOWS. Fails silently on any internal error (bad transcript, missing
# catalog, unwritable log): the monitor must never wedge or nag the agent.
SKILLS_DIR="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)}/skills"
export VK_SKILLS_DIR="$SKILLS_DIR"
node -e '
const fs = require("fs"), path = require("path"), os = require("os");
function allow(){ process.stdout.write(JSON.stringify({ continue: true })); process.exit(0); }
const norm = s => String(s).toLowerCase().replace(/[^a-z0-9]/g, "");
(function main(){
  let input = ""; try { input = fs.readFileSync(0, "utf8"); } catch (e) { return allow(); }
  let data; try { data = JSON.parse(input); } catch (e) { return allow(); }
  const ti = (data && data.tool_input) || {};
  const fp = ti.file_path || ti.notebook_path || ti.path || "";
  if (!fp) return allow();
  const cwd = data.cwd || process.cwd();
  const abs = path.isAbsolute(fp) ? fp : path.join(cwd, fp);
  // Gate only genuinely Kit-relevant edits: an ArkTS (.ets) file whose new
  // content pulls in a HarmonyOS SDK module (@kit./@ohos./@hms.). Edits with no
  // Kit to select -- pure ArkTS logic, UI-only scaffolding, docs, config, asset
  // files inside the project -- are never gated, so the gate stops firing (and
  // stops nagging) on edits where there is no Kit to choose.
  function newContent(t){
    const parts = [];
    if (typeof t.content === "string") parts.push(t.content);        // Write
    if (typeof t.new_string === "string") parts.push(t.new_string);  // Edit
    if (typeof t.new_source === "string") parts.push(t.new_source);  // NotebookEdit
    if (Array.isArray(t.edits)) for (const e of t.edits) { if (e && typeof e.new_string === "string") parts.push(e.new_string); }
    return parts.join("\n");
  }
  const usesKit = /@(kit|ohos|hms)\./i.test(newContent(ti));
  if (!/\.ets$/i.test(abs) || !usesKit) return allow();   // not a Kit-using ArkTS edit -> ungated
  // Gated: require a Kit named since the last user prompt.
  let lines; try { lines = fs.readFileSync(data.transcript_path, "utf8").split(/\r?\n/).filter(Boolean); } catch (e) { return allow(); }
  const entries = [];
  for (const ln of lines) { try { entries.push(JSON.parse(ln)); } catch (e) {} }
  function role(e){ const m = e && e.message; return (m && m.role) || (e && e.role) || (e && e.type); }
  function isUserPrompt(e){
    if (role(e) !== "user") return false;
    const c = e && e.message && e.message.content;
    if (typeof c === "string") return true;
    if (Array.isArray(c)) return c.some(p => p && p.type === "text");
    return false;
  }
  let startIdx = -1;
  for (let i = 0; i < entries.length; i++) { if (isUserPrompt(entries[i])) startIdx = i; }
  // Catalog Kit slugs.
  let known = [];
  try { known = fs.readdirSync(process.env.VK_SKILLS_DIR).filter(n => { try { return fs.statSync(path.join(process.env.VK_SKILLS_DIR, n)).isDirectory(); } catch (e) { return false; } }); } catch (e) {}
  if (!known.length) return allow();   // cannot determine catalog -> fail open
  const matchSet = known.map(norm);
  function assistantText(e){
    if (role(e) !== "assistant") return "";
    const c = e && e.message && e.message.content;
    if (typeof c === "string") return c;
    if (Array.isArray(c)) return c.filter(p => p && p.type === "text" && typeof p.text === "string").map(p => p.text).join(" ");
    return "";
  }
  for (let i = startIdx + 1; i < entries.length; i++) {
    const raw = assistantText(entries[i]);
    if (/<verikit-no-kit\b/i.test(raw)) return allow();   // explicit abstain: agent declared no applicable Kit
    const t = norm(raw);
    if (!t) continue;
    for (const k of matchSet) { if (k && t.indexOf(k) !== -1) return allow(); }
  }
  // Would-flag: a Kit-relevant edit with no Kit selected. Do not block, do not
  // message -- append a debug record (with any routed-Kit suggestions for
  // context) and ALLOW. Best-effort: a log failure must never block the edit.
  let suggest = "";
  let lastR = -1;
  for (let i = 0; i < entries.length; i++) { if (JSON.stringify(entries[i]).indexOf("<verikit-routing>") !== -1) lastR = i; }
  if (lastR >= 0) {
    const rs = JSON.stringify(entries[lastR]);
    const SCAFF = { arkts: 1, arkui: 1, "ability-kit": 1 };
    suggest = known.filter(k => rs.indexOf(k) !== -1 && !SCAFF[k]).slice(0, 6).join(", ");
  }
  try {
    const logDir = process.env.VK_LOG_DIR || path.join(os.homedir(), ".verikit");
    fs.mkdirSync(logDir, { recursive: true });
    const rec = { ts: new Date().toISOString(), tool: data.tool_name || "", file: abs, suggest: suggest || undefined };
    fs.appendFileSync(path.join(logDir, "gate.log"), JSON.stringify(rec) + "\n");
  } catch (e) {}
  return allow();
})();
'
