{
  "name": "@verikit/claude-code-plugin",
  "version": "0.0.8",
  "description": "VeriKit — HarmonyOS Kit selection for LLM agents, packaged as a Claude Code plugin. Ranks the 100 HarmonyOS SDK Kits against the task, surfaces the matched composition-recipe bundle, and lists the top task-relevant reference docs per Kit.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:plugin": "node scripts/build-plugin.mjs",
    "build:plugins": "node scripts/build-plugin.mjs --all",
    "test": "node --test test/plugins.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "verikit": "./dist/verikit-cli.js"
  },
  "files": [
    ".claude-plugin",
    "bin",
    "commands",
    "hooks",
    "lib",
    "scripts",
    "packaging",
    "plugin-target.json",
    "docs",
    "test",
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "harmonyos",
    "arkts",
    "skills",
    "skill-routing",
    "kit-selection",
    "agent-tools",
    "claude-code"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rshu/VeriKit.git"
  },
  "homepage": "https://github.com/rshu/VeriKit"
}
